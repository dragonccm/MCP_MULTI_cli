    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "private": true
