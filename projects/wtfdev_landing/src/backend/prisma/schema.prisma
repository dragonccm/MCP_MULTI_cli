generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactInquiry {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  email           String   @db.VarChar(255)
  message         String   @db.Text
  company         String?  @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  serviceInterest String?  @map("service_interest") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  status          String   @default("pending") @db.VarChar(20)

  @@index([email], name: "idx_contactinquiry_email")
  @@index([status], name: "idx_contactinquiry_status")
  @@index([createdAt(sort: Desc)], name: "idx_contactinquiry_created_at")
  @@map("contact_inquiry")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz()
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz()
  source         String?   @default("website") @db.VarChar(50)

  @@index([email], name: "idx_newsletter_subscriber_email")
  @@map("newsletter_subscriber")
}

model PortfolioProject {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  description  String   @db.Text
  category     String   @db.VarChar(100)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  galleryUrls  Json     @default("[]") @map("gallery_urls")
  clientName   String?  @map("client_name") @db.VarChar(255)
  technologies Json     @default("[]")
  outcome      String?  @db.Text
  published    Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category], name: "idx_portfolio_project_category")
  @@index([createdAt(sort: Desc)], name: "idx_portfolio_project_created_at")
  @@map("portfolio_project")
}

model Service {
  id               String  @id @default(uuid()) @db.Uuid
  name             String  @db.VarChar(100)
  slug             String  @unique @db.VarChar(100)
  shortDescription String  @map("short_description") @db.VarChar(255)
  fullDescription  String  @map("full_description") @db.Text
  iconUrl          String? @map("icon_url") @db.VarChar(500)
  features         Json    @default("[]")
  displayOrder     Int     @default(0) @map("display_order")
  active           Boolean @default(true)

  @@index([slug], name: "idx_service_slug")
  @@index([displayOrder], name: "idx_service_display_order")
  @@map("service")
}
